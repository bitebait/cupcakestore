# Application configuration (all defaults allow local development without .env)
APP_HOST=0.0.0.0
APP_PORT=8080
DEV_MODE=true

# Database: sqlite or postgres
DB_TYPE=sqlite
DB_PATH=gorm.db
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432
# Use disable only for a trusted local PostgreSQL server without TLS.
DB_SSLMODE=require
DB_TIMEZONE=America/Sao_Paulo

# Local redirect paths
REDIRECT_AFTER_LOGIN=/store
REDIRECT_AFTER_LOGOUT=/store

# Optional initial administrator. No account is created when both are empty.
# Choose a unique password of 12 to 72 bytes. Existing accounts are never changed.
# Remove these values after the first successful startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required when DEV_MODE=false (the application serves HTTPS directly)
CERT_FILE_PATH=
KEY_FILE_PATH=
